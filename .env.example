APP_ENV=development
PORT=8080
SERVER_ADDRESS=:8080
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
JWT_SECRET=dev-secret-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
READ_HEADER_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
